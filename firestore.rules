rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estas cuentas de Google pueden leer y escribir.
    // Para dar acceso a otra persona, agrega su correo a la lista.
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'rodrigo.briones.friz@gmail.com'
        ];
    }

    match /ninos/{nino} {
      allow read, write: if permitido();
    }
    match /ninos/{nino}/{document=**} {
      allow read, write: if permitido();
    }
  }
}
